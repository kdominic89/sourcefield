# Inert template. Replace SOURCEFIELD_COMMIT with the same actual SHA as sourcefield.lock.json.
name: Update profile
on:
  workflow_dispatch:
    inputs:
      include_private_count:
        description: Include only the aggregate number of private repositories (requires PROFILE_TOKEN)
        required: false
        type: boolean
        default: false
  schedule:
    - cron: '17 5 * * *'
permissions:
  contents: read
concurrency:
  group: sourcefield-publication
  cancel-in-progress: false
jobs:
  generate:
    uses: kdominic89/sourcefield/.github/workflows/generate.yml@SOURCEFIELD_COMMIT
    with:
      config: config/profile.toml
      # Organization profiles select both; personal profiles select only README.md.
      readmes: '["README.md", "profile/README.md"]'
      include_private_count: ${{ (github.event_name == 'workflow_dispatch' && inputs.include_private_count) || vars.SOURCEFIELD_PRIVATE_COUNTS == 'true' }}
    secrets:
      PROFILE_TOKEN: ${{ secrets.PROFILE_TOKEN }}
  publish:
    outputs:
      pages_artifact: ${{ steps.artifact_name.outputs.name }}
    needs: generate
    runs-on: ubuntu-24.04
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: ${{ needs.generate.outputs.artifact }}
          path: ${{ runner.temp }}/candidate
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: kdominic89/sourcefield
          ref: ${{ needs.generate.outputs.source_commit }}
          path: .sourcefield-tools
          persist-credentials: false
      - name: Assign a publication-attempt artifact identity
        id: artifact_name
        env:
          ARTIFACT_NAME: github-pages-${{ github.run_id }}-${{ github.run_attempt }}
        run: printf 'name=%s\n' "$ARTIFACT_NAME" >> "$GITHUB_OUTPUT"
      # Prepare the immutable deployment artifact before any Git publication can succeed.
      - uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
        with:
          name: ${{ steps.artifact_name.outputs.name }}
          path: ${{ runner.temp }}/candidate/docs
      - name: Apply only owned files and publish against the expected source revision
        env:
          EXPECTED_COMMIT: ${{ github.sha }}
          TARGET_BRANCH: ${{ github.event.repository.default_branch }}
        run: |
          python3 .sourcefield-tools/scripts/consumer_publish.py --checkout "$GITHUB_WORKSPACE" --candidate "$RUNNER_TEMP/candidate" --expected-commit "$EXPECTED_COMMIT" --branch "$TARGET_BRANCH"
          if ! git diff --cached --quiet; then
            git -c user.name='github-actions[bot]' -c user.email='41898282+github-actions[bot]@users.noreply.github.com' commit -m 'chore(profile): refresh generated sourcefield'
            git push origin "HEAD:refs/heads/$TARGET_BRANCH"
          fi
  deploy:
    needs: publish
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      # Re-running a failed deployment reuses the uploaded Pages artifact; it never republishes Git.
      - name: Deploy the same validated candidate after repository publication
        id: deployment
        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5.0.1
        with:
          artifact_name: ${{ needs.publish.outputs.pages_artifact }}
